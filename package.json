{
  "name": "modern-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Rajdip Ghosh - Senior Software Engineer & Angular Specialist Modern Portfolio with Glassmorphism UI & SSR",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
